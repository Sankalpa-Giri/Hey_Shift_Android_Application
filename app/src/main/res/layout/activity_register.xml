<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFBFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Top spacing + back -->
        <Space android:layout_width="match_parent" android:layout_height="40dp"/>

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_circle_outline"
            android:src="@android:drawable/ic_media_previous"
            android:padding="10dp"
            android:contentDescription="Back"
            android:layout_marginBottom="32dp"/>

        <!-- Gold bar + heading -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:background="@drawable/gold_bar_bg"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#0A1628"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join thousands of smart users"
            android:textSize="13sp"
            android:textColor="#8A95A3"
            android:layout_marginBottom="32dp"/>

        <!-- Full Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#0A1628"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/input_name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Your full name"
            android:inputType="textPersonName"
            android:textColor="#0A1628"
            android:textColorHint="#BFC8D2"
            android:textSize="15sp"
            android:background="@drawable/input_field_clean"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="20dp"/>

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email Address"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#0A1628"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/input_email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="you@example.com"
            android:inputType="textEmailAddress"
            android:textColor="#0A1628"
            android:textColorHint="#BFC8D2"
            android:textSize="15sp"
            android:background="@drawable/input_field_clean"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="20dp"/>

        <!-- Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#0A1628"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Min. 6 characters"
            android:inputType="textPassword"
            android:textColor="#0A1628"
            android:textColorHint="#BFC8D2"
            android:textSize="15sp"
            android:background="@drawable/input_field_clean"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="32dp"/>

        <!-- Register Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Create Account"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A1628"
            app:cornerRadius="12dp"
            android:letterSpacing="0.04"
            android:layout_marginBottom="14dp"/>

        <ProgressBar
            android:id="@+id/register_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="#F5A623"
            android:visibility="gone"
            android:layout_marginBottom="14dp"/>

        <!-- Login link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textSize="14sp"
                android:textColor="#8A95A3"/>

            <TextView
                android:id="@+id/tv_go_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#F5A623"/>
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="32dp"/>

    </LinearLayout>
</ScrollView>