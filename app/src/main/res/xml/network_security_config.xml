<?xml version="1.0" encoding="utf-8"?>
<!--
    FIX: Allows cleartext (HTTP) traffic to local network IPs so you can
    point BASE_URL at 192.168.x.x during development without a certificate.
    ngrok always uses HTTPS so it is safe regardless, but this file also
    ensures Android does not block it due to strict HTTPS-only policies.
-->
<network-security-config>
    <!-- Trust system CAs for all domains (covers ngrok HTTPS) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext HTTP only for local network IPs (development) -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Common local subnets — add your actual subnet if different -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>   <!-- Android Emulator host -->
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>

    <!-- ngrok domains — always HTTPS, listed explicitly for clarity -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">ngrok-free.app</domain>
        <domain includeSubdomains="true">ngrok.io</domain>
    </domain-config>
</network-security-config>